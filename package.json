{
  "name": "calculator-app",
  "version": "1.0.0",
  "description": "A clean calculator app built with HTML, CSS, and JavaScript",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "jest --forceExit",
    "test:coverage": "jest --forceExit --coverage"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "calculator-logic.js",
      "server.js"
    ]
  },
  "devDependencies": {
    "@jest/globals": "^30.3.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0"
  }
}
